# BONUS VARIANT: exec-style liveness probe
# Instead of an HTTP call, Kubernetes runs a command INSIDE the container.
# Exit code 0 = healthy, any non-zero exit code = unhealthy.
#
# Here we reuse curl inside the container to hit the same /healthz endpoint,
# which behaves identically to the httpGet probe but demonstrates the
# `exec` probe type and command-based health checks in general
# (useful for apps with no HTTP interface, e.g. checking a PID file,
# a queue depth, or a database connection with a CLI tool).

apiVersion: apps/v1
kind: Deployment
metadata:
  name: liveness-demo-exec
  labels:
    app: liveness-demo-exec
spec:
  replicas: 1
  selector:
    matchLabels:
      app: liveness-demo-exec
  template:
    metadata:
      labels:
        app: liveness-demo-exec
    spec:
      containers:
        - name: healthapp
          image: <your-dockerhub-username>/liveness-demo:v1
          ports:
            - containerPort: 5000
          env:
            - name: AUTO_FAIL_AFTER
              value: "45"
          livenessProbe:
            exec:
              command:
                - sh
                - -c
                - "wget -q -O- http://localhost:5000/healthz || exit 1"
            initialDelaySeconds: 10
            periodSeconds: 5
            timeoutSeconds: 2
            failureThreshold: 3
